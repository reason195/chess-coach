# Copy to .env.local for local development. NEVER commit .env.local.
# App Check debug token: run the dev server once with the debug provider
# enabled (see src/ai/firebase.ts), copy the token printed in the browser
# console, register it in Firebase Console -> App Check -> Manage debug
# tokens, then paste it here.
VITE_APPCHECK_DEBUG_TOKEN=
# Cloud Gemini model used for deep review (Firebase AI Logic, Gemini Dev API)
VITE_CLOUD_MODEL=gemini-3.8-flash
